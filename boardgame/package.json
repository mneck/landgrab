{
  "name": "landgrab-boardgame",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run build:server && node .server-build/server.mjs",
    "dev:all": "npm run dev:server & npm run dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "serve": "npm run build:server && NODE_ENV=production node .server-build/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "playtest": "tsx playtesting/runBatch.mts",
    "maps": "python3 tools/mapgen/build_maps.py",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=.server-build/server.mjs --log-level=warning"
  },
  "dependencies": {
    "boardgame.io": "^0.50.2",
    "d3-delaunay": "^6.0.4",
    "koa-static": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/d3-delaunay": "^6.0.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "tsx": "^4.21.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.10",
    "vitest": "^4.1.2"
  }
}
